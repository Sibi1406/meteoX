rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile: only authenticated owner can read/write
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Weather cache: read-only for authenticated clients, written by Cloud Functions
    match /weather_cache/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Forecast records: read-only for authenticated clients, created by Cloud Functions
    match /forecast_records/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Weather observations (ground truth vs user): read-only for authenticated clients
    match /weather_observations/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Trust scores: read-only for authenticated clients, computed by Cloud Functions
    match /trust_scores/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Role rules: read-only for authenticated clients, managed by Cloud Functions/Admin
    match /role_rules/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Active weather alerts: read-only for authenticated clients
    match /alerts/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Alert deliveries: user can only read alerts delivered to their own account
    match /alert_deliveries/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Query logs: user can only read their own query audit logs
    match /query_logs/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Backward-compatible queries collection
    match /queries/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Feedback collection: user can read their own feedback records
    match /feedback/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
